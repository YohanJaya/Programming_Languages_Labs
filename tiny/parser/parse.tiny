%%
Tiny       -> PROGRAM Name ':' Dclns Body Name '.' 	=> "program";
Dclns      -> VAR (Dcln ';')*				=> "dclns"
           -> 					     	=> "dclns";
Dcln       -> Name list ',' ':' Type			=> "dcln";
Type       -> INTEGER 		             		=> "integer"
           -> BOOLEAN				     	=> "boolean";
Body       -> BEGINX Statement list ';' END      	=> "block";
Statement  -> Name ASSIGNMENT Expression          	=> "assign"
           -> OUTPUT '(' ExprList ')'             	=> "output"
           -> IF Expression THEN Statement
                            ELSE Statement       	=> "if"
           -> IF Expression THEN Statement         	=> "if"
           -> WHILE Expression DO Statement      	=> "while"
           -> FOR Name ASSIGNMENT Expression TO Expression DO Statement      => "for_to"
           -> FOR Name ASSIGNMENT Expression DOWNTO Expression DO Statement  => "for_downto"
           -> REPEAT Statement list ';' UNTIL Expression     => "repeat"
           -> CASE Expression OF (CaseClause ';')+ OtherwiseClause END    => "case"
           -> Name SWAP Name                              => "swap"
           -> LOOP Statement list ';' POOL                => "loop"
           -> EXIT                                        => "exit"
           -> Body
	       ->                                       => "<null>";
ExprList   -> Expression (',' Expression)*;

CaseClause -> INTEGER_NUM ':' Statement                     => "case_clause"
           -> INTEGER_NUM DOTDOT INTEGER_NUM ':' Statement  => "case_clause_range";

OtherwiseClause -> OTHERWISE Statement                                 => "otherwise"
                ->                                                     => "<null>";

Expression -> OrExpr LTE OrExpr                       	=> "<="
           -> OrExpr EQUAL OrExpr                     	=> "="
           -> OrExpr NOT_EQUAL OrExpr                 	=> "<>"
           -> OrExpr GTE OrExpr                       	=> ">="
           -> OrExpr LT OrExpr                        	=> "<"
           -> OrExpr GT OrExpr                        	=> ">"
           -> OrExpr;

OrExpr     -> OrExpr PLUS AndExpr                     	=> "+"
           -> OrExpr MINUS AndExpr                    	=> "-"
           -> OrExpr OR AndExpr                       	=> "or"
           -> AndExpr;

AndExpr    -> AndExpr MULTIPLY UnaryExpr              	=> "*"
           -> AndExpr DIVIDE UnaryExpr                	=> "/"
           -> AndExpr AND UnaryExpr                   	=> "and"
           -> AndExpr MOD UnaryExpr                   	=> "mod"
           -> UnaryExpr;

UnaryExpr  -> MINUS UnaryExpr                         	=> "-"
           -> PLUS UnaryExpr                          	=> "+"
           -> NOT UnaryExpr                           	=> "not"
           -> PowerExpr;

PowerExpr  -> Primary POWER PowerExpr                 	=> "**"
           -> Primary;

Primary    -> READ                              	=> "read"
           -> EOFX                               	=> "eof"
           -> Name
           -> INTEGER_NUM				=> "<integer>"
           -> TRUE					=> "<true>"
           -> FALSE					=> "<false>"
           -> '(' Expression ')';

Name       -> IDENTIFIER				=> "<identifier>";